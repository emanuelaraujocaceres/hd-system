# ╔══════════════════════════════════════════════════════════════╗
# ║  Variáveis de Ambiente — HD-System                    ║
# ║  Copie este arquivo para .env.local e preencha os valores    ║
# ╚══════════════════════════════════════════════════════════════╝

# Google Gemini AI API Key (Dashboard AI + Scanner de Câmera)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# App URL (usado em redirects)
APP_URL=https://hd-system.pages.dev

# Supabase Credentials
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sentry (Opcional — erros em produção)
# Obtenha em: https://sentry.io → Settings → Client Keys (DSN)
VITE_SENTRY_DSN=
# Sentry CLI (para source maps — apenas CI/deploy)
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_AUTH_TOKEN=your-auth-token

# Cloudflare Pages — configure via Dashboard > Settings > Environment variables
# As variáveis VITE_* são embutidas no build do frontend
# As outras são usadas apenas nas Pages Functions (server-side)
