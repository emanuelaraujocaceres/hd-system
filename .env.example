# ╔══════════════════════════════════════════════════════════════╗
# ║  Variáveis de Ambiente — HD-System ERP                       ║
# ║  Copie este arquivo para .env.local e preencha os valores    ║
# ╚══════════════════════════════════════════════════════════════╝

# Google Gemini AI API Key (Dashboard AI + Scanner de Câmera)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# App URL (usado em redirects)
APP_URL=https://hd-system.pages.dev

# Supabase Credentials
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Pages — configure via Dashboard > Settings > Environment variables
# As variáveis VITE_* são embutidas no build do frontend
# As outras são usadas apenas nas Pages Functions (server-side)
